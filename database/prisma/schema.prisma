generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProductType {
  FLOWER
  EDIBLE
  CONCENTRATE
  TINCTURE
  TOPICAL
  CAPSULE
}

enum AcquisitionType {
  PURCHASED
  HOMEGROWN
}

enum SessionMethod {
  SMOKE
  VAPE
  EDIBLE
  DAB
  TINCTURE
}

enum MetricCategory {
  PAIN
  MENTAL
  SLEEP
  DIGESTIVE
  ENERGY
  MOOD
  OTHER
}

enum EffectCategory {
  POSITIVE
  NEGATIVE
  COGNITIVE
  PHYSICAL
  SOCIAL
  OTHER
}

model Organization {
  id   String @id @default(uuid())
  name String

  users    User[]
  products Product[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  email     String  @unique
  username  String? @unique
  firstName String
  lastName  String?

  role UserRole @default(MEMBER)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Cultivar {
  id   String @id @default(uuid())
  name String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid())

  name String

  productType     ProductType
  acquisitionType AcquisitionType

  brand       String?
  batchNumber String?

  packageWeight Decimal?
  thcPercent    Decimal?
  cbdPercent    Decimal?
  cbgPercent    Decimal?
  cbnPercent    Decimal?

  cultivarId String?
  cultivar   Cultivar? @relation(fields: [cultivarId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([cultivarId])
}

model Session {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  method SessionMethod

  startedAt DateTime

  doseAmount Decimal?

  notes String?

  sessionMetrics SessionMetric[]

  sessionEffects SessionEffect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Metric {
  id String @id @default(uuid())

  name        String         @unique
  description String?
  category    MetricCategory

  sessionMetrics SessionMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Effect {
  id String @id @default(uuid())

  name        String         @unique
  description String?
  category    EffectCategory

  sessionEffects SessionEffect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SessionMetric {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  metricId String
  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  beforeValue Int
  afterValue  Int

  createdAt DateTime @default(now())

  @@unique([sessionId, metricId])
  @@index([sessionId])
  @@index([metricId])
}

model SessionEffect {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  effectId String
  effect   Effect @relation(fields: [effectId], references: [id], onDelete: Cascade)

  intensity Int?

  createdAt DateTime @default(now())

  @@unique([sessionId, effectId])
  @@index([sessionId])
  @@index([effectId])
}
